gBalance);\r\n        // Act and assert\r\n        Assert.Throws\u003CSystem.ArgumentOutOfRangeException\u003E(() =\u003E account.Debit(debitAmount));\r\n    }\r\n\r\n    [Fact]\r\n    public void Debit_WhenAmountIsMoreThanBalance_ShouldThrowArgumentOutOfRange()\r\n    {\r\n        // Arrange\r\n        double beginningBalance = 11.99;\r\n        double debitAmount = 20.0;\r\n        BankAccount account = new BankAccount(\u0022Mr. Bryan Walton\u0022, beginningBalance);\r\n        // Act\r\n        try\r\n        {\r\n            account.Debit(debitAmount);\r\n        }\r\n        catch (System.ArgumentOutOfRangeException e)\r\n        {\r\n            // Assert\r\n            Assert.Contains(BankAccount.DebitAmountExceedsBalanceMessage, e.Message);\r\n        }\r\n    }\r\n}\r\n","tests":[{"id":"515a0dac-79e4-467e-1b08-57b1fdcbb7a1","name":"Bank.Domain.Tests.BankAccountTests.MultiDebit_WithValidAmount_UpdatesBalance","location":{"start":{"line":8,"column":5},"end":{"line":21,"column":6}}},{"id":"b722b744-5576-5edb-99bd-81766c28a4fd","name":"Bank.Domain.Tests.BankAccountTests.MultiDebit_WithValidAmount_UpdatesBalance","location":{"start":{"line":8,"column":5},"end":{"line":21,"column":6}}},{"id":"02d85496-f8cb-fcfe-f0f5-075440b367de","name":"Bank.Domain.Tests.BankAccountTests.Debit_WhenAmountIsLessThanZero_ShouldThrowArgumentOutOfRange","location":{"start":{"line":23,"column":5},"end":{"line":32,"column":6}}},{"id":"d53c7d93-8770-7041-50ba-fe9cbae9b519","name":"Bank.Domain.Tests.BankAccountTests.Debit_WhenAmountIsMoreThanBalance_ShouldThrowArgumentOutOfRange","location":{"start":{"line":34,"column":5},"end":{"line":51,"column":6}}}]}},"thresholds":{"high":80,"low":60}}