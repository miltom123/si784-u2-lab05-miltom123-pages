npublic class BankAccountTests\n{\n    /// \u003Csummary\u003EConserva los dos escenarios de d\u00E9bito de la gu\u00EDa.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022beginningBalance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    /// \u003Cparam name=\u0022debitAmount\u0022\u003EImporte del d\u00E9bito.\u003C/param\u003E\n    /// \u003Cparam name=\u0022expected\u0022\u003ESaldo esperado.\u003C/param\u003E\n    [Theory]\n    [InlineData(11.99, 4.55, 7.44)]\n    [InlineData(12.3, 5.2, 7.1)]\n    public void MultiDebit_WithValidAmount_UpdatesBalance(\n        double beginningBalance, double debitAmount, double expected)\n    {\n        var account = new BankAccount(\u0022Mr. Bryan Walton\u0022, beginningBalance);\n        account.Debit(debitAmount);\n        Assert.Equal(Math.Round(expected, 2), Math.Round(account.Balance, 2));\n    }\n\n    /// \u003Csummary\u003EEl d\u00E9bito negativo informa el argumento y conserva el saldo.\u003C/summary\u003E\n    [Fact]\n    public void Debit_WhenAmountIsLessThanZero_ShouldThrowArgumentOutOfRange()\n    {\n        var account = new BankAccount(\u0022Alumno\u0022, 11.99);\n        var error = Assert.Throws\u003CArgumentOutOfRangeException\u003E(() =\u003E account.Debit(-100));\n        Assert.Equal(\u0022amount\u0022, error.ParamName);\n        Assert.Equal(-100d, error.ActualValue);\n        Assert.Contains(BankAccount.DebitAmountLessThanZeroMessage, error.Message);\n        Assert.Equal(11.99, account.Balance);\n    }\n\n    /// \u003Csummary\u003EEl sobregiro debe lanzar una excepci\u00F3n y conservar el saldo.\u003C/summary\u003E\n    [Fact]\n    public void Debit_WhenAmountIsMoreThanBalance_ShouldThrowArgumentOutOfRange()\n    {\n        var account = new BankAccount(\u0022Alumno\u0022, 11.99);\n        var error = Assert.Throws\u003CArgumentOutOfRangeException\u003E(() =\u003E account.Debit(20));\n        Assert.Equal(\u0022amount\u0022, error.ParamName);\n        Assert.Equal(20d, error.ActualValue);\n        Assert.Contains(BankAccount.DebitAmountExceedsBalanceMessage, error.Message);\n        Assert.Equal(11.99, account.Balance);\n    }\n\n    /// \u003Csummary\u003EEl d\u00E9bito permite cero y el importe exacto del saldo.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte del d\u00E9bito.\u003C/param\u003E\n    /// \u003Cparam name=\u0022expected\u0022\u003ESaldo final.\u003C/param\u003E\n    [Theory]\n    [InlineData(11.99, 11.99, 0)]\n    [InlineData(11.99, 0, 11.99)]\n    [InlineData(0, 0, 0)]\n    public void Debit_BoundaryAmount_UpdatesBalance(double balance, double amount, double expected)\n    {\n        var account = new BankAccount(\u0022Alumno\u0022, balance);\n        account.Debit(amount);\n        Assert.Equal(expected, account.Balance);\n    }\n\n    /// \u003Csummary\u003EEl cr\u00E9dito suma importes positivos y permite cero.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte del cr\u00E9dito.\u003C/param\u003E\n    /// \u003Cparam name=\u0022expected\u0022\u003ESaldo final.\u003C/param\u003E\n    [Theory]\n    [InlineData(11.99, 5.77, 17.76)]\n    [InlineData(0, 2.5, 2.5)]\n    [InlineData(11.99, 0, 11.99)]\n    [InlineData(0, 0, 0)]\n    public void Credit_ValidAmount_UpdatesBalance(double balance, double amount, double expected)\n    {\n        var account = new BankAccount(\u0022Alumno\u0022, balance);\n        account.Credit(amount);\n        Assert.Equal(expected, account.Balance, 2);\n    }\n\n    /// \u003Csummary\u003EEl cr\u00E9dito negativo debe fallar sin modificar el saldo.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte negativo.\u003C/param\u003E\n    [Theory]\n    [InlineData(11.99, -1)]\n    [InlineData(0, -0.01)]\n    public void Credit_NegativeAmount_ThrowsWithoutChangingBalance(double balance, double amount)\n    {\n        var account = new BankAccount(\u0022Alumno\u0022, balance);\n        var error = Assert.Throws\u003CArgumentOutOfRangeException\u003E(() =\u003E account.Credit(amount));\n        Assert.Equal(\u0022amount\u0022, error.ParamName);\n        Assert.Equal(balance, account.Balance);\n    }\n\n    /// \u003Csummary\u003EEl constructor expone el titular y saldo recibidos.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022name\u0022\u003ETitular de la cuenta.\u003C/param\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    [Theory]\n    [InlineData(\u0022Milton H. Flores Chino\u0022, 11.99)]\n    [InlineData(\u0022Alumno\u0022, 0)]\n    [InlineData(\u0022\u0022, 3.5)]\n    public void Constructor_InitializesCustomerAndBalance(string name, double balance)\n    {\n        var account = new BankAccount(name, balance);\n        Assert.Equal(name, account.CustomerName);\n        Assert.Equal(balance, account.Balance);\n    }\n\n    /// \u003Csummary\u003EUna secuencia de operaciones conserva titular y saldo esperado.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    /// \u003Cparam name=\u0022debit\u0022\u003ED\u00E9bito a aplicar.\u003C/param\u003E\n    /// \u003Cparam name=\u0022credit\u0022\u003ECr\u00E9dito a aplicar.\u003C/param\u003E\n    /// \u003Cparam name=\u0022expected\u0022\u003ESaldo final.\u003C/param\u003E\n    [Theory]\n    [InlineData(20, 5, 2, 17)]\n    [InlineData(0, 0, 5, 5)]\n    public void Transactions_UpdateBalanceAndPreserveCustomer(\n        double balance, double debit, double credit, double expected)\n    {\n        var account = new BankAccount(\u0022Milton\u0022, balance);\n        account.Debit(debit);\n        account.Credit(credit);\n        Assert.Equal(expected, account.Balance);\n        Assert.Equal(\u0022Milton\u0022, account.CustomerName);\n    }\n}\n","tests":[{"id":"515a0dac-79e4-467e-1b08-57b1fdcbb7a1","name":"Bank.Domain.Tests.BankAccountTests.MultiDebit_WithValidAmount_UpdatesBalance","location":{"start":{"line":12,"column":5},"end":{"line":21,"column":6}}},{"id":"b722b744-5576-5edb-99bd-81766c28a4fd","name":"Bank.Domain.Tests.BankAccountTests.MultiDebit_WithValidAmount_UpdatesBalance","location":{"start":{"line":12,"column":5},"end":{"line":21,"column":6}}},{"id":"02d85496-f8cb-fcfe-f0f5-075440b367de","name":"Bank.Domain.Tests.BankAccountTests.Debit_WhenAmountIsLessThanZero_ShouldThrowArgumentOutOfRange","location":{"start":{"line":24,"column":5},"end":{"line":33,"column":6}}},{"id":"d53c7d93-8770-7041-50ba-fe9cbae9b519","name":"Bank.Domain.Tests.BankAccountTests.Debit_WhenAmountIsMoreThanBalance_ShouldThrowArgumentOutOfRange","location":{"start":{"line":36,"column":5},"end":{"line":45,"column":6}}},{"id":"c0860fa3-8b9a-b4fa-71c8-bd6d90bac679","name":"Bank.Domain.Tests.BankAccountTests.Debit_BoundaryAmount_UpdatesBalance","location":{"start":{"line":51,"column":5},"end":{"line":60,"column":6}}},{"id":"56cb07b6-1c09-054b-c4f4-1eac98c8ede7","name":"Bank.Domain.Tests.BankAccountTests.Debit_BoundaryAmount_UpdatesBalance","location":{"start":{"line":51,"column":5},"end":{"line":60,"column":6}}},{"id":"4daa6027-a763-6235-0e2f-31bde54d9c68","name":"Bank.Domain.Tests.BankAccountTests.Debit_BoundaryAmount_UpdatesBalance","location":{"start":{"line":51,"column":5},"end":{"line":60,"column":6}}},{"id":"d131d3e8-3991-602b-337e-6148ff921a2e","name":"Bank.Domain.Tests.BankAccountTests.Credit_ValidAmount_UpdatesBalance","location":{"start":{"line":66,"column":5},"end":{"line":76,"column":6}}},{"id":"2362defb-e96d-6c4b-86f8-b73b08372649","name":"Bank.Domain.Tests.BankAccountTests.Credit_ValidAmount_UpdatesBalance","location":{"start":{"line":66,"column":5},"end":{"line":76,"column":6}}},{"id":"4e652947-a44f-e959-5c0e-ef4758a3b7ca","name":"Bank.Domain.Tests.BankAccountTests.Credit_ValidAmount_UpdatesBalance","location":{"start":{"line":66,"column":5},"end":{"line":76,"column":6}}},{"id":"13d68020-ac19-7328-3846-5679ff4cf4be","name":"Bank.Domain.Tests.BankAccountTests.Credit_ValidAmount_UpdatesBalance","location":{"start":{"line":66,"column":5},"end":{"line":76,"column":6}}},{"id":"4cdf5340-ed17-8ddf-e50a-e6e448e26434","name":"Bank.Domain.Tests.BankAccountTests.Credit_NegativeAmount_ThrowsWithoutChangingBalance","location":{"start":{"line":81,"column":5},"end":{"line":90,"column":6}}},{"id":"33d3c213-51e9-1342-e9dc-3840c72b889a","name":"Bank.Domain.Tests.BankAccountTests.Credit_NegativeAmount_ThrowsWithoutChangingBalance","location":{"start":{"line":81,"column":5},"end":{"line":90,"column":6}}},{"id":"40d1c934-e4f9-8d9b-fbc1-811a44e16ea1","name":"Bank.Domain.Tests.BankAccountTests.Constructor_InitializesCustomerAndBalance","location":{"start":{"line":95,"column":5},"end":{"line":104,"column":6}}},{"id":"abd5aa44-5911-f8ce-efb5-ed76ce74d8e9","name":"Bank.Domain.Tests.BankAccountTests.Constructor_InitializesCustomerAndBalance","location":{"start":{"line":95,"column":5},"end":{"line":104,"column":6}}},{"id":"ef349243-1612-9361-0164-9bd6ec8ea2a0","name":"Bank.Domain.Tests.BankAccountTests.Constructor_InitializesCustomerAndBalance","location":{"start":{"line":95,"column":5},"end":{"line":104,"column":6}}},{"id":"3ce05433-f6c1-3080-4eff-d25e274ac894","name":"Bank.Domain.Tests.BankAccountTests.Transactions_UpdateBalanceAndPreserveCustomer","location":{"start":{"line":111,"column":5},"end":{"line":122,"column":6}}},{"id":"1ba34ec0-3000-c791-1a6f-7947c2b50589","name":"Bank.Domain.Tests.BankAccountTests.Transactions_UpdateBalanceAndPreserveCustomer","location":{"start":{"line":111,"column":5},"end":{"line":122,"column":6}}}]}},"thresholds":{"high":100,"low":100}}