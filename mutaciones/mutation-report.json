{"files":{"/home/runner/work/si784-2026-ii-si784-2026-ii-u2-lab05-miltom123/si784-2026-ii-si784-2026-ii-u2-lab05-miltom123/Bank/Bank.Domain/BankAccount.cs":{"language":"cs","source":"namespace Bank.Domain;\n\n/// \u003Csummary\u003ECuenta bancaria con operaciones de d\u00E9bito y cr\u00E9dito.\u003C/summary\u003E\npublic class BankAccount\n{\n    /// \u003Csummary\u003EMensaje para un d\u00E9bito mayor al saldo.\u003C/summary\u003E\n    public const string DebitAmountExceedsBalanceMessage = \u0022Debit amount exceeds balance\u0022;\n    /// \u003Csummary\u003EMensaje para un d\u00E9bito negativo.\u003C/summary\u003E\n    public const string DebitAmountLessThanZeroMessage = \u0022Debit amount is less than zero\u0022;\n    /// \u003Csummary\u003ENombre del titular de la cuenta.\u003C/summary\u003E\n    private readonly string m_customerName;\n    /// \u003Csummary\u003ESaldo actual de la cuenta.\u003C/summary\u003E\n    private double m_balance;\n    /// \u003Csummary\u003ECrea una cuenta con titular y saldo inicial.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022customerName\u0022\u003ENombre del titular.\u003C/param\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    public BankAccount(string customerName, double balance)\n    {\n        m_customerName = customerName;\n        m_balance = balance;\n    }\n    /// \u003Csummary\u003EObtiene el titular de la cuenta.\u003C/summary\u003E\n    public string CustomerName { get { return m_customerName; } }\n    /// \u003Csummary\u003EObtiene el saldo actual.\u003C/summary\u003E\n    public double Balance { get { return m_balance; }  }\n    /// \u003Csummary\u003EDescuenta un importe no negativo que no exceda el saldo.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte a debitar.\u003C/param\u003E\n    /// \u003Cexception cref=\u0022ArgumentOutOfRangeException\u0022\u003EImporte negativo o mayor al saldo.\u003C/exception\u003E\n    public void Debit(double amount)\n    {\n        if (amount \u003E m_balance)\n            throw new ArgumentOutOfRangeException(\u0022amount\u0022, amount, DebitAmountExceedsBalanceMessage);\n        if (amount \u003C 0)\n            throw new ArgumentOutOfRangeException(\u0022amount\u0022, amount, DebitAmountLessThanZeroMessage);\n        m_balance -= amount; \n    }\n    /// \u003Csummary\u003EAbona un importe no negativo.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte a acreditar.\u003C/param\u003E\n    /// \u003Cexception cref=\u0022ArgumentOutOfRangeException\u0022\u003EImporte negativo.\u003C/exception\u003E\n    public void Credit(double amount)\n    {\n        if (amount \u003C 0)\n            throw new ArgumentOutOfRangeException(\u0022amount\u0022);\n        m_balance \u002B= amount;\n    }\n}\n\n","mutants":[{"id":"0","mutatorName":"Block removal mutation","replacement":"{}","location":{"start":{"line":18,"column":5},"end":{"line":21,"column":6}},"status":"Killed","static":false,"coveredBy":["33d3c213-51e9-1342-e9dc-3840c72b889a","4cdf5340-ed17-8ddf-e50a-e6e448e26434","ef349243-1612-9361-0164-9bd6ec8ea2a0","abd5aa44-5911-f8ce-efb5-ed76ce74d8e9","40d1c934-e4f9-8d9b-fbc1-811a44e16ea1","b722b744-5576-5edb-99bd-81766c28a4fd","515a0dac-79e4-467e-1b08-57b1fdcbb7a1","02d85496-f8cb-fcfe-f0f5-075440b367de","4daa6027-a763-6235-0e2f-31bde54d9c68","c0860fa3-8b9a-b4fa-71c8-bd6d90bac679","56cb07b6-1c09-054b-c4f4-1eac98c8ede7","4e652947-a44f-e959-5c0e-ef4758a3b7ca","d131d3e8-3991-602b-337e-6148ff921a2e","13d68020-ac19-7328-3846-5679ff4cf4be","2362defb-e96d-6c4b-86f8-b73b08372649","3ce05433-f6c1-3080-4eff-d25e274ac894","1ba34ec0-3000-c791-1a6f-7947c2b50589","d53c7d93-8770-7041-50ba-fe9cbae9b519"],"killedBy":["4cdf5340-ed17-8ddf-e50a-e6e448e26434","ef349243-1612-9361-0164-9bd6ec8ea2a0","abd5aa44-5911-f8ce-efb5-ed76ce74d8e9","40d1c934-e4f9-8d9b-fbc1-811a44e16ea1","b722b744-5576-5edb-99bd-81766c28a4fd","515a0dac-79e4-467e-1b08-57b1fdcbb7a1","02d85496-f8cb-fcfe